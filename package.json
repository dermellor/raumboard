{
  "name": "lernraum-board",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bash scripts/dev-prep.sh && concurrently -k -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:pm2": "concurrently -k -n api,web -c blue,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "RAUMBOARD_DEFAULT_TENANT=dev RAUMBOARD_DEV=1 tsx watch server/index.ts",
    "dev:web": "VITE_API=true vite",
    "dev:demo": "vite",
    "dev:worktree": "vite --strictPort --port ${WT_PORT:-32100}",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.11",
    "better-sqlite3": "^13.0.1",
    "hono": "^4.12.32",
    "lucide-react": "^1.25.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsx": "^4.23.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
