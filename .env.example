# Raumboard configuration. Every setting is an environment variable; the app
# reads no config file of its own.
#
# Where these values go depends on how you run it:
#   - production (systemd): the unit's EnvironmentFile, e.g. /opt/raumboard/.env
#   - production (docker):  the container's environment
#   - local development:    an instance profile outside the repo, see below
#
# Copy this file to the place that fits and fill it in. It is a checked-in
# example, so it holds no real values.

# --- Server ------------------------------------------------------------

# Port the Hono API server listens on.
RAUMBOARD_PORT=3211

# Port the Vite dev server listens on (local development only). The Vite config
# reads both ports, so two instances can run side by side and each proxies /api
# to its own API server.
RAUMBOARD_WEB_PORT=3210

# Directory holding one SQLite file per school (<slug>.db). Must be writable by
# the service user and included in your backups. Default: ./data next to the app.
RAUMBOARD_DATA=/opt/raumboard/data

# Base domain. A request's Host header decides the tenant:
# <slug>.<RAUMBOARD_DOMAIN> → data/<slug>.db. The apex and www are the landing
# page, foreign hosts are refused.
RAUMBOARD_DOMAIN=raumboard.de

# The switch between the two operating modes:
#   set to a slug  -> self-hosted mode. One school, every Host maps to it, no
#                     subdomain routing.
#   empty          -> platform mode. Many schools, the tenant comes from the
#                     Host header. Also disables the dev auto-seed.
RAUMBOARD_DEFAULT_TENANT=

# Secret for signing session cookies and teacher-PIN tokens. Generate with
#   openssl rand -base64 32
# In production the server refuses to start without it. NEVER commit the value.
RAUMBOARD_SECRET=

# --- Local development only --------------------------------------------

# With RAUMBOARD_DEV=1 the server auto-provisions RAUMBOARD_DEFAULT_TENANT with
# seed data and fixed local credentials (dev@raumboard.local / raumboard, teacher
# PIN 0000). `npm run dev` sets it; it is ignored when NODE_ENV=production, so it
# cannot leak into a real install. Never set it on a server.
# RAUMBOARD_DEV=1

# --- Instances ---------------------------------------------------------
# One checkout can address several deployments: a local test board, a staging
# server, production. An instance is a name plus the values above (plus the
# DEPLOY_* values below), kept in a file OUTSIDE the repo:
#
#   ~/.config/raumboard/instances/<name>.env
#
# Select one by exporting its name; anything already in the environment wins:
#
#   RAUMBOARD_INSTANCE=staging npm run dev
#   RAUMBOARD_INSTANCE=prod bash deploy/deploy.sh
#
# RAUMBOARD_INSTANCE_DIR moves the profile directory. Unset RAUMBOARD_INSTANCE
# is the plain single-deployment case and reads nothing outside the repo.
# Loader: scripts/instance.sh.

# --- Deployment (deploy/deploy.sh, on the developer machine) -----------
# These configure the deploy script, not the server. They belong in an instance
# profile rather than here.
#
#   DEPLOY_HOST     SSH host or alias of the target server      (required)
#   DEPLOY_PATH     app directory on the server                 (default /opt/raumboard/app)
#   DEPLOY_USER     service user for chown                      (default raumboard)
#   DEPLOY_SERVICE  systemd service name                        (default raumboard)
#   DEPLOY_DOMAIN   a domain the server serves, for healthcheck (default raumboard.de)

# --- Backups (deploy/backup.sh, on the server) -------------------------
# Sourced from the server-side env file named by RAUMBOARD_ENV
# (default /opt/raumboard/.env).
#
#   BACKUP_DATA          dir holding <slug>.db      (default /opt/raumboard/data)
#   BACKUP_WORK          scratch dir                (default /opt/raumboard/backups)
#   BACKUP_STORAGE_ZONE  object-storage zone/bucket (required)
#   BACKUP_STORAGE_HOST  storage endpoint host      (default storage.bunnycdn.com)
#   BACKUP_STORAGE_KEY   storage access key         (required — secret)
#   BACKUP_ENC_KEY       AES-256 passphrase         (required — secret)
